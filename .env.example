# Copy to .env and fill in.

# Needed for automatic reading of the whiteboard photo (https://console.anthropic.com).
# Without it you can still upload the photo and type the rows by hand.
ANTHROPIC_API_KEY=

# Long random string used to sign the session cookie.
SECRET_KEY=change-me

# Optional: require this password to open the site (any username).
APP_PASSWORD=

# Optional overrides
# ICE_DATA_DIR=./data
# TRACKER_PATH=./data/Tracker.xlsx
# RIDERS=Amped,Khurtz,Ram,Mark,Mike,Jomar,Pickup
# INACTIVE_DAYS=5
# ANTHROPIC_MODEL=claude-opus-5-5
